# Application
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Infrastructure (development values only)
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
DATABASE_URL=postgresql+asyncpg://nexus:nexus@postgres:5432/nexus
REDIS_URL=redis://redis:6379/0

# Provider selection. Models are never downloaded automatically.
NEXUS_LLM_PROVIDER=ollama
NEXUS_OLLAMA_BASE_URL=http://ollama:11434
NEXUS_OLLAMA_MODEL=
NEXUS_LLM_BASE_URL=
NEXUS_LLM_API_KEY=
NEXUS_LLM_MODEL=
OLLAMA_IMAGE=ollama/ollama:latest

# Agent safety limits and gated features
NEXUS_MAX_AGENT_ITERATIONS=12
NEXUS_ENABLE_WEB_SEARCH=false
NEXUS_ENABLE_VOICE=false
NEXUS_VOICE_PROVIDER=whisper_cpp
# Native backend: http://localhost:8080; Docker Desktop: host.docker.internal.
NEXUS_WHISPER_BASE_URL=http://host.docker.internal:8080
NEXUS_VOICE_MAX_SECONDS=60
NEXUS_VOICE_TIMEOUT_SECONDS=60
NEXUS_VOICE_MAX_SESSIONS=4
NEXUS_ENABLE_CODE_EXECUTION=false
